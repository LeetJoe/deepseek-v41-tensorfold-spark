+@contextmanager
+def serving(backend, tmp_path, *, fail=False):
+    if backend == "cuda":
+        app = app_for(tmp_path, Engine())
+        with http_server(app) as port:
+            yield app, port
+    else:
+        app = FakeApp(reasoning="hmm", fail_stream=fail)
+        server = serve_fake(app)
+        try:
+            yield app, server.server_port
+        finally:
+            server.shutdown()
+            server.server_close()
